# ── SHARED ───────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
API_KEY=your-secret-api-key-here

# ── SERVER ────────────────────────────────────────────────────────────────────
PORT=3000
DATABASE_URL=postgresql://user:password@ep-xxx-yyy.us-east-2.aws.neon.tech/notifyhub?sslmode=require

# ── FIREBASE FCM ──────────────────────────────────────────────────────────────
# From Firebase Console → Project Settings → Service accounts → Generate new private key
# Compact the JSON: jq -c . serviceAccountKey.json
FCM_SERVICE_ACCOUNT_JSON=
# From your primary phone: temporarily log FirebaseMessaging.getInstance().getToken() and read via adb logcat
FCM_DEVICE_TOKEN=

# ── ANDROID BUILD (set in ~/.gradle/gradle.properties, NOT committed) ─────────
# API_KEY=same-value-as-above
# SERVER_URL=https://notifyhub.onrender.com
