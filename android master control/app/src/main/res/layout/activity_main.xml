<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="@string/setup_title"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Complete these steps once to enable background sync."
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Step 1: Notification Access -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:cardBackgroundColor="#1E1E1E"
            app:cardCornerRadius="12dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Grant Notification Access"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Tap the button, find this app, and enable access."
                    android:textColor="#AAAAAA"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_notification_access"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/btn_notification_access"
                    android:onClick="openNotificationListenerSettings" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Step 2: Accessibility (text capture) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#1E1E1E"
            app:cardCornerRadius="12dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. Grant Text Capture Access"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Tap the button, find “Sync text capture”, and enable it. On Android 13+ sideloaded builds, first tap the disabled entry, then App info → ⋮ → Allow restricted settings."
                    android:textColor="#AAAAAA"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_accessibility"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/btn_accessibility_access"
                    android:onClick="openAccessibilitySettings" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Step 3: Media capture -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#1E1E1E"
            app:cardCornerRadius="12dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/media_capture_title"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/media_capture_body"
                    android:textColor="#AAAAAA"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/media_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="#CCCCCC"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_media"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:checked="true"
                    android:text="@string/media_capture_enable"
                    android:textColor="#FFFFFF" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_wifi_only"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/media_wifi_only"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btn_media_access"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_media_access"
                    android:onClick="requestMediaAccess" />

                <Button
                    android:id="@+id/btn_all_files_access"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_all_files_access"
                    android:onClick="requestAllFilesAccess" />

                <Button
                    android:id="@+id/btn_downloads_folder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_downloads_folder"
                    android:onClick="chooseDownloadsFolder" />

                <Button
                    android:id="@+id/btn_scan_media"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_scan_media"
                    android:onClick="scanRecentMedia" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Step 4: Battery Optimization -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#1E1E1E"
            app:cardCornerRadius="12dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4. Allow Unrestricted Battery"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="A prompt was shown on launch. If you missed it, you can re-trigger it here."
                    android:textColor="#AAAAAA"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_battery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Request Battery Exemption"
                    android:onClick="requestBatteryExemption" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Step 4: MIUI extras (Redmi/Xiaomi only) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_miui"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="#1E1E1E"
            app:cardCornerRadius="12dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5. Xiaomi Background Permissions"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="MIUI kills background apps unless all three are allowed: 1) Enable Autostart, 2) Battery saver → No restrictions, 3) App details → Background autostart → Allow. Finally, open Recents, long-press this app's card and tap the padlock."
                    android:textColor="#AAAAAA"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_miui_autostart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Enable Autostart"
                    android:onClick="openAutostartSettings" />

                <Button
                    android:id="@+id/btn_miui_battery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Battery: No Restrictions"
                    android:onClick="openBatterySaverSettings" />

                <Button
                    android:id="@+id/btn_miui_appdetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="App Details (Background Autostart)"
                    android:onClick="openMiuiAppDetails" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Step 5: mute security-review alerts -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#1E1E1E"
            app:cardCornerRadius="12dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6. Silence Security-Review Alerts"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Android periodically shows “Review app with full device access” prompts from the Permission Controller. Tap the button and turn OFF notifications for the Permission Controller app. The app also auto-dismisses those alerts from the shade and auto-taps “Keep” if the review screen opens, so a phone left unattended is never blocked. If you ever open one manually, choose Keep."
                    android:textColor="#AAAAAA"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_hide_security"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Mute Security Alerts"
                    android:onClick="hideSecurityAlerts" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Finish -->
        <Button
            android:id="@+id/btn_finish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="48dp"
            android:text="@string/btn_finish_setup"
            android:onClick="finishSetup"
            style="@style/Widget.MaterialComponents.Button" />

    </LinearLayout>
</ScrollView>
