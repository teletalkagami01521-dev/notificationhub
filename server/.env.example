# ── Server ───────────────────────────────────────────────────────────────────
# Generate a strong key: openssl rand -hex 32
API_KEY=your-secret-api-key-here

PORT=3000

# ── Neon PostgreSQL ───────────────────────────────────────────────────────────
# From your Neon project dashboard → Connection Details
DATABASE_URL=postgresql://user:password@ep-xxx-yyy.us-east-2.aws.neon.tech/notifyhub?sslmode=require

# ── Firebase Cloud Messaging ──────────────────────────────────────────────────
# Download from Firebase Console → Project Settings → Service accounts → Generate new private key
# Paste the entire JSON content as a single line (use jq -c . key.json to compact it)
FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Your primary phone's FCM registration token
# Get this by temporarily calling FirebaseMessaging.getInstance().getToken() in the Android app
# and reading it from adb logcat
FCM_DEVICE_TOKEN=
